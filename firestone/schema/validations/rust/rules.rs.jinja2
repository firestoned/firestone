//! The validation rules for this API.
//!
//! Generated by firestone. Do not edit: change the `references` and
//! `validations` blocks in your resource schemas and regenerate.
{% if has_expr %}//!
//! Some of these rules carry a CEL expression, so this crate needs the `cel`
//! feature, which is on by default.
{% endif %}
use std::collections::HashMap;
use std::sync::LazyLock;

use serde::Deserialize;
use serde_json::Value;

/// A single lookup a rule declares.
#[derive(Clone, Debug, Deserialize)]
pub struct Ref {
    /// The name the expression refers to this lookup by.
    pub name: String,
    /// The resource kind to look up.
    pub kind: String,
    /// The path into that resource to match on.
    pub key: String,
    /// The path in the request body holding the value to look up.
    pub value: String,
    /// Whether the rule still runs when this lookup finds nothing.
    pub optional: bool,
}

/// What to answer with when a rule fails.
#[derive(Clone, Debug, Deserialize)]
pub struct RuleError {
    /// The HTTP status code.
    pub status: u16,
    /// The message, which may carry `{self.city}` style placeholders.
    pub message: String,
}

/// A case the rule must accept or reject, used by the generated tests.
#[derive(Clone, Debug, Deserialize)]
pub struct Example {
    /// The request body.
    #[serde(rename = "self")]
    pub subject: Value,
    /// The resource as it currently stands.
    pub old: Option<Value>,
    /// The resources the resolver would find, keyed by ref name.
    pub refs: Value,
    /// Anything else the rule reads.
    pub ctx: Value,
    /// Whether the rule should accept or reject this case.
    pub expect: String,
}

/// One validation rule.
#[derive(Clone, Debug, Deserialize)]
pub struct Rule {
    /// Unique within the resource; violations are reported under it.
    pub name: String,
    /// What this rule enforces, and why.
    pub description: Option<String>,
    /// The resource kind this rule belongs to.
    pub resource: String,
    /// `exists`, `immutable` or `expr`.
    pub kind: String,
    /// The field this rule is about, for the reported violation.
    pub field: Option<String>,
    /// The HTTP methods this rule runs on.
    pub methods: Vec<String>,
    /// The lookups this rule needs.
    pub refs: Vec<Ref>,
    /// The CEL expression, for a rule of kind `expr`.
    pub expr: Option<String>,
    /// What to answer with when this rule fails.
    pub error: RuleError,
    /// Cases this rule must accept or reject.
    #[serde(default)]
    pub examples: Vec<Example>,
}

/// The rules as generated, before they are parsed.
const RULES_JSON: &str = {{ rules_literal }};

/// Every rule, keyed by the resource kind it applies to.
pub static RULES: LazyLock<HashMap<String, Vec<Rule>>> =
    LazyLock::new(|| serde_json::from_str(RULES_JSON).expect("firestone generated invalid rules"));
