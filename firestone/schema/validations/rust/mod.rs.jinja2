/// Run every generated rule that applies to this request.
///
/// # Errors
///
/// [`Error::Validation`] when rules rejected the request, [`Error::Rule`] when a
/// rule could not be evaluated, [`Error::Resolver`] when a lookup failed.
pub async fn validate(
    request: Request<'_>,
    resolver: Option<&mut dyn Resolver>,
) -> Result<(), Error> {
    runtime::validate_with_rules(&RULES, request, resolver).await
}
