//! Declarative validations for this API.
//!
//! Generated by firestone from the `references` and `validations` blocks in the
//! resource schemas. Rules are data, in `rules.rs`; the engine is in `runtime.rs`;
//! the interface you implement is in `ports.rs`.
//!
//! Nothing here depends on firestone at runtime. Add to your `Cargo.toml`:
//!
//! ```toml
//! [dependencies]
//! async-trait = "0.1"
//! serde = { version = "1", features = ["derive"] }
//! serde_json = "1"
{% if has_expr %}//! cel-interpreter = { version = "0.10", optional = true }
//!
//! [features]
//! default = ["cel"]
//! cel = ["dep:cel-interpreter"]
{% endif %}{% if has_examples %}//!
//! [dev-dependencies]
//! tokio = { version = "1", features = ["macros", "rt"] }
{% endif %}//! ```
//!
//! Typical use, from a server handler:
//!
//! ```ignore
//! use myapi::validation::{validate, Error, Request};
//!
//! match validate(Request::new("post", "addressbook").body(&body), Some(&mut resolver)).await {
//!     Ok(()) => {}
//!     Err(Error::Validation(failed)) => {
//!         return (StatusCode::from_u16(failed.status())?, Json(failed.to_problem()))
//!             .into_response();
//!     }
//!     Err(other) => return internal_error(other),
//! }
//! ```
//!
//! Serve the problem document as `application/problem+json`: that is what the
//! generated OpenAPI document declares, and RFC 9457 puts its members at the top
//! level of the body rather than under a wrapper key.

