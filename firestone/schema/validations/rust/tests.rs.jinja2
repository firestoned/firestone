//! Tests for the validation rules, generated from the examples in the resource schemas.
//!
//! Generated by firestone. Do not edit: add or change `examples` on a rule and
//! regenerate. The rules run against an in-memory resolver, so no database, and
//! no server, is needed.

use async_trait::async_trait;
use serde_json::Value;

use super::ports::Error;
use super::ports::RefRequest;
use super::ports::Resolved;
use super::ports::Resolver;
use super::ports::ResolverError;
use super::rules::Rule;
use super::rules::RULES;
use super::runtime::validate_with_rules;
use super::runtime::Request;

/// One entry per example: the resource, the rule, the method, and the example index.
const EXAMPLES: &str = {{ examples_literal }};

/// Returns the resources an example declares, instead of hitting a database.
struct FakeResolver {
    rule: Rule,
    refs: Value,
}

#[async_trait]
impl Resolver for FakeResolver {
    async fn resolve(
        &mut self,
        requests: &[RefRequest],
        _ctx: &Value,
    ) -> Result<Resolved, ResolverError> {
        let mut resolved = Resolved::new();
        for request in requests {
            for reference in &self.rule.refs {
                if reference.kind != request.kind || reference.key != request.key {
                    continue;
                }
                if let Some(found) = self.refs.get(&reference.name) {
                    if !found.is_null() {
                        resolved.insert(request.id(), found.clone());
                    }
                }
            }
        }

        Ok(resolved)
    }
}

fn get_rule(resource: &str, name: &str) -> Rule {
    RULES
        .get(resource)
        .and_then(|rules| rules.iter().find(|rule| rule.name == name))
        .unwrap_or_else(|| panic!("No rule named '{name}' on {resource}"))
        .clone()
}

/// Check that every rule accepts or rejects its examples as the schema says it should.
#[tokio::test]
async fn rule_examples() {
    let cases: Vec<(String, String, String, usize)> =
        serde_json::from_str(EXAMPLES).expect("firestone generated invalid examples");

    for (resource, name, op, index) in cases {
        let rule = get_rule(&resource, &name);
        let example = rule.examples[index].clone();
        let mut resolver = FakeResolver {
            rule: rule.clone(),
            refs: example.refs.clone(),
        };

        let mut rules = std::collections::HashMap::new();
        rules.insert(resource.clone(), vec![rule]);

        let old = example.old.clone();
        let mut request = Request::new(&op, &resource)
            .body(&example.subject)
            .ctx(&example.ctx);
        if let Some(old) = old.as_ref() {
            request = request.old(old);
        }

        let result = validate_with_rules(&rules, request, Some(&mut resolver)).await;
        let case = format!("{resource}-{name}-{index}");

        match (example.expect.as_str(), result) {
            ("pass", Ok(())) => {}
            ("pass", Err(err)) => panic!("{case}: expected to pass, got {err}"),
            ("fail", Err(Error::Validation(failed))) => {
                assert_eq!(failed.violations[0].rule, name, "{case}: wrong rule failed");
            }
            ("fail", Ok(())) => panic!("{case}: expected to fail, but passed"),
            ("fail", Err(err)) => panic!("{case}: expected a validation failure, got {err}"),
            (other, _) => panic!("{case}: unknown expectation '{other}'"),
        }
    }
}
