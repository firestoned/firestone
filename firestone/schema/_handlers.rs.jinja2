pub async fn handle_{{ rsrc["module_name"] }}_command(
    ctx: &ApiContext,
    cmd: &{{ rsrc["pascal_name"] }}Commands,
) -> Result<(), Box<dyn std::error::Error>> {
    match cmd {
{% for op in rsrc["operations"]["resource"]|sort(attribute='name') -%}
        {{ rsrc["pascal_name"] }}Commands::{{ op["pascal_name"] }}(args) => {
            handle_{{ rsrc["module_name"] }}_{{ op["id"] | replace(rsrc["name"] ~ "_", "") }}(ctx, args).await
        },
{% endfor -%}
{% for op in rsrc["operations"]["instance"]|sort(attribute='name') -%}
        {{ rsrc["pascal_name"] }}Commands::{{ op["pascal_name"] }}(args) => {
            handle_{{ rsrc["module_name"] }}_{{ op["id"] | replace(rsrc["name"] ~ "_", "") }}(ctx, args).await
        },
{% endfor -%}
    }
}

{# Resource operation handlers -#}
{% for op in rsrc["operations"]["resource"]|sort(attribute='name') -%}
pub async fn handle_{{ rsrc["module_name"] }}_{{ op["id"] | replace(rsrc["name"] ~ "_", "") }}(
    ctx: &ApiContext,
    args: &{{ op["pascal_name"] }}Args,
) -> Result<(), Box<dyn std::error::Error>> {
    {{ init_config(rsrc["client_pkg"]) }}
    {% if op["name"] == "create" -%}
    // Build request body for create operation
    let req_body = {{ rsrc["client_pkg"] }}::models::Create{{ rsrc["comp_name_pascal"] }} {
        {% for attr in op["attrs"]|sort(attribute='name') -%}
        {% if attr.get("in") != "query" -%}
        {{ attr["rust_name"] }}: {% if attr.get("body_conversion") == "ENUM_MATCH" -%}
        {% if attr.get("required") -%}
        match args.{{ attr["rust_name"] }} {
            {% for mapping in attr.get("enum_variant_mappings", []) -%}
            {{ attr["type"] }}::{{ mapping["cli_variant"] }} => {{ attr.get("enum_model_type") }}::{{ mapping["model_variant"] }},
            {% endfor -%}
        }
        {%- elif attr.get("default") -%}
        Some(match args.{{ attr["rust_name"] }} {
            {% for mapping in attr.get("enum_variant_mappings", []) -%}
            {{ attr["type"] }}::{{ mapping["cli_variant"] }} => {{ attr.get("enum_model_type") }}::{{ mapping["model_variant"] }},
            {% endfor -%}
        })
        {%- else -%}
        args.{{ attr["rust_name"] }}.as_ref().map(|e| match e {
            {% for mapping in attr.get("enum_variant_mappings", []) -%}
            {{ attr["type"] }}::{{ mapping["cli_variant"] }} => {{ attr.get("enum_model_type") }}::{{ mapping["model_variant"] }},
            {% endfor -%}
        })
        {%- endif -%}
{% elif attr.get("body_conversion") == "ENUM_ARRAY_MATCH" -%}
        args.{{ attr["rust_name"] }}.iter().map(|s| match s.to_lowercase().as_str() {
            {% for mapping in attr.get("enum_variant_mappings", []) -%}
            "{{ mapping["cli_variant"]|lower }}" => {{ attr.get("enum_item_type") }}::{{ mapping["model_variant"] }},
            {% endfor -%}
            _ => panic!("Invalid enum value for {{ attr["name"] }}: {}", s),
        }).collect(){% elif attr.get("body_conversion") and attr.get("body_conversion") != "None" -%}{{ attr["body_conversion"] }}{% else -%}args.{{ attr["rust_name"] }}.clone(){% endif -%},
        {% endif -%}
        {% endfor -%}
    };
    // Build query parameters for create operation
    {% for qp in op.get("query_params", []) -%}
    {% if qp["type"] == "String" -%}
    {% if qp["required"] -%}
    let {{ qp["rust_name"] }}_param = Some(args.{{ qp["rust_name"] }}.as_str());
    {% else -%}
    let {{ qp["rust_name"] }}_param = args.{{ qp["rust_name"] }}.as_ref().map(|s| s.as_str());
    {% endif -%}
    {% elif qp["type"] == "i64" -%}
    {% if qp["required"] -%}
    let {{ qp["rust_name"] }}_param = args.{{ qp["rust_name"] }} as i32;
    {% else -%}
    let {{ qp["rust_name"] }}_param = args.{{ qp["rust_name"] }}.map(|v| v as i32);
    {% endif -%}
    {% else -%}
    {# Enum or other type: convert via AsRef<str> to avoid moving out of &args #}
    {% if qp["required"] -%}
    let {{ qp["rust_name"] }}_param = Some(args.{{ qp["rust_name"] }}.as_ref());
    {% else -%}
    let {{ qp["rust_name"] }}_param = args.{{ qp["rust_name"] }}.as_ref().map(|e| e.as_ref());
    {% endif -%}
    {% endif -%}
    {% endfor -%}
    let resp = {{ rsrc["client_pkg"] }}::apis::{{ rsrc["name"] }}_api::{{ op["id"] }}(&config, req_body{% for qp in op.get("query_params", []) %}, {{ qp["rust_name"] }}_param{% endfor %}).await?;
    let json_output = serde_json::to_string_pretty(&resp)?;
    println!("{}", json_output);
    {% else -%}
    // Build query parameters - openapi-generator functions take individual Option parameters
    {% for qp in op.get("query_params", []) -%}
    {% if qp["type"] == "String" -%}
    {% if qp["required"] -%}
    let {{ qp["rust_name"] }}_param = Some(args.{{ qp["rust_name"] }}.as_str());
    {% else -%}
    let {{ qp["rust_name"] }}_param = args.{{ qp["rust_name"] }}.as_ref().map(|s| s.as_str());
    {% endif -%}
    {% elif qp["type"] == "i64" -%}
    {% if qp["required"] -%}
    let {{ qp["rust_name"] }}_param = args.{{ qp["rust_name"] }} as i32;
    {% else -%}
    let {{ qp["rust_name"] }}_param = args.{{ qp["rust_name"] }}.map(|v| v as i32);
    {% endif -%}
    {% else -%}
    {# Enum or other type: convert via AsRef<str> to avoid moving out of &args #}
    {% if qp["required"] -%}
    let {{ qp["rust_name"] }}_param = Some(args.{{ qp["rust_name"] }}.as_ref());
    {% else -%}
    let {{ qp["rust_name"] }}_param = args.{{ qp["rust_name"] }}.as_ref().map(|e| e.as_ref());
    {% endif -%}
    {% endif -%}
    {% endfor -%}
    {% if op["name"] == "delete" -%}
    // DELETE operations may return empty responses (204 No Content)
    let resp_result = {{ rsrc["client_pkg"] }}::apis::{{ rsrc["name"] }}_api::{{ op["id"] }}(&config{% for qp in op.get("query_params", []) %}, {{ qp["rust_name"] }}_param{% endfor %}).await;
    match resp_result {
        Ok(data) => {
            let json_output = serde_json::to_string_pretty(&data)?;
            println!("{}", json_output);
        },
        Err({{ rsrc["client_pkg"] }}::apis::Error::Serde(e)) => {
            let error_msg = e.to_string();
            if error_msg.contains("content type") || error_msg.contains("application/octet-stream") || error_msg.contains("cannot be converted") {
                println!("{}", r#"{"status": "deleted"}"#);
            } else {
                return Err(Box::new(e));
            }
        },
        Err(e) => return Err(Box::new(e)),
    }
    {% else -%}
    let resp = {{ rsrc["client_pkg"] }}::apis::{{ rsrc["name"] }}_api::{{ op["id"] }}(&config{% for qp in op.get("query_params", []) %}, {{ qp["rust_name"] }}_param{% endfor %}).await?;
    let json_output = serde_json::to_string_pretty(&resp)?;
    println!("{}", json_output);
    {% endif -%}
    {% endif -%}
    Ok(())
}

{% endfor -%}

