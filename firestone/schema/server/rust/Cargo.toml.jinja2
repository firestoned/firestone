# {{ title }}
#
# Generated by firestone. The handlers, models, router and middleware are
# regenerated from the resource files; anything you write yourself belongs in its
# own module so it survives.
[package]
name = "{{ pkg }}"
version = "{{ crate_version }}"
edition = "2021"
# LazyLock, and Option::is_none_or in the validation engine.
rust-version = "1.82"
description = "{{ description }}"

[dependencies]
axum = "0.8"
tokio = { version = "1", features = ["rt-multi-thread", "macros", "signal"] }
tower = "0.5"
tower-http = { version = "0.6", features = ["trace", "timeout", "limit", "cors"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
{%- if validations %}
async-trait = "0.1"
cel-interpreter = { version = "0.10", optional = true }
{%- else %}
async-trait = "0.1"
{%- endif %}
{% if validations %}
[features]
default = ["cel"]
# Only the rules carrying a CEL expression need this.
cel = ["dep:cel-interpreter"]
{% endif %}
[dev-dependencies]
http-body-util = "0.1"
tower = { version = "0.5", features = ["util"] }
