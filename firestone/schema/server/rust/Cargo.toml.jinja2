# {{ title }}
#
# The glue between the generated server and your storage. The server itself is the
# sibling crate, generated by openapi-generator from the OpenAPI document; this one
# implements its traits.
[package]
name = "{{ pkg }}"
version = "{{ crate_version }}"
edition = "2021"
# The generated engine uses LazyLock, and Option::is_none_or in the
# validation runtime.
rust-version = "1.82"
description = {{ description_toml }}

[dependencies]
{{ api_pkg }} = { path = "../api" }
axum = "0.8"
axum-extra = { version = "0.10", features = ["cookie"] }
http = "1"
tokio = { version = "1", features = ["rt-multi-thread", "macros", "signal"] }
tower-http = { version = "0.6", features = ["trace"] }
async-trait = "0.1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
{%- if secured %}
# Constant-time token comparison, rather than hand rolling one in security code.
subtle = "2"
{%- endif %}
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }
{%- if validations %}
cel-interpreter = { version = "0.10", optional = true }
{%- endif %}
{% if validations %}
[features]
default = ["cel"]
# Only the rules carrying a CEL expression need this.
cel = ["dep:cel-interpreter"]
{% endif %}

[dev-dependencies]
http-body-util = "0.1"
tokio = { version = "1", features = ["macros", "rt"] }
tower = { version = "0.5", features = ["util"] }
