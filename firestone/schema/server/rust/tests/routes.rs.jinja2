//! Smoke tests for the generated routes.
//!
//! Generated by firestone from the same resource files as the router, so a route
//! that stops being reachable, or an unsecured route that should have been secured,
//! fails here. The app is driven directly rather than over a socket, so nothing
//! binds a port.

use std::sync::Arc;

use axum::body::Body;
use axum::http::Request;
use axum::http::StatusCode;
use tower::ServiceExt;

use {{ pkg }}::backend::InMemory;
use {{ pkg }}::middleware::Auth;
use {{ pkg }}::middleware::RateLimit;
use {{ pkg }}::router;
use {{ pkg }}::AppState;

/// A server with nothing stored and one accepted token.
fn app() -> axum::Router {
    let mut state = AppState::new(Arc::new(InMemory::new()));
    state.auth = Arc::new(Auth::new(["test-token".to_string()]));
    state.rate_limit = Arc::new(RateLimit::new(10_000, std::time::Duration::from_secs(60)));

    router(state)
}

async fn call(method: &str, path: &str, token: Option<&str>) -> StatusCode {
    let mut request = Request::builder().method(method).uri(path);
    if let Some(token) = token {
        request = request.header("authorization", format!("Bearer {token}"));
    }

    app()
        .oneshot(request.body(Body::empty()).expect("the request builds"))
        .await
        .expect("the router answers")
        .status()
}
{% for rsrc in resources %}
{%- if "get" in rsrc.resource_methods and "get" not in rsrc.secured_resource %}
#[tokio::test]
async fn {{ rsrc.module }}_collection_is_reachable() {
    assert_eq!(call("GET", "/{{ rsrc.path }}", None).await, StatusCode::OK);
}
{% endif %}
{%- if "get" in rsrc.instance_methods and "get" not in rsrc.secured_instance %}
#[tokio::test]
async fn {{ rsrc.module }}_instance_is_not_found_when_absent() {
    assert_eq!(
        call("GET", "/{{ rsrc.path }}/nope", None).await,
        StatusCode::NOT_FOUND
    );
}
{% endif %}
{%- if "get" in rsrc.attr_methods and "get" not in rsrc.secured_attrs %}
#[tokio::test]
async fn {{ rsrc.module }}_attribute_is_routed() {
    // The instance is absent, so a 404 rather than a 405 says the route matched.
    assert_eq!(
        call("GET", "/{{ rsrc.path }}/nope/{{ rsrc.attrs[0] }}", None).await,
        StatusCode::NOT_FOUND
    );
}

#[tokio::test]
async fn {{ rsrc.module }}_head_is_answered_on_an_attribute() {
    // axum answers HEAD wherever GET is routed, which is what the schema's `head`
    // on an attribute asks for.
    assert_eq!(
        call("HEAD", "/{{ rsrc.path }}/nope/{{ rsrc.attrs[0] }}", None).await,
        StatusCode::NOT_FOUND
    );
}
{% endif %}
{%- for method in rsrc.secured_instance %}
{%- if method in rsrc.instance_methods %}
#[tokio::test]
async fn {{ rsrc.module }}_{{ method }}_instance_needs_a_token() {
    assert_eq!(
        call("{{ method | upper }}", "/{{ rsrc.path }}/anything", None).await,
        StatusCode::UNAUTHORIZED
    );
    assert_ne!(
        call(
            "{{ method | upper }}",
            "/{{ rsrc.path }}/anything",
            Some("test-token")
        )
        .await,
        StatusCode::UNAUTHORIZED
    );
}
{% endif %}
{%- endfor %}
{%- endfor %}

#[tokio::test]
async fn an_unknown_route_is_not_found() {
    assert_eq!(
        call("GET", "/no-such-resource", None).await,
        StatusCode::NOT_FOUND
    );
}
