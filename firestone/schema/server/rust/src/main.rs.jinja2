/// Stop serving on Ctrl-C or SIGTERM, letting in-flight requests finish.
async fn shutdown() {
    let interrupt = async {
        signal::ctrl_c()
            .await
            .expect("the interrupt handler installs");
    };

    #[cfg(unix)]
    let terminate = async {
        signal::unix::signal(signal::unix::SignalKind::terminate())
            .expect("the terminate handler installs")
            .recv()
            .await;
    };
    #[cfg(not(unix))]
    let terminate = std::future::pending::<()>();

    tokio::select! {
        () = interrupt => tracing::info!("interrupted, shutting down"),
        () = terminate => tracing::info!("terminated, shutting down"),
    }
