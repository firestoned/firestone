//! The router, from the paths and methods in the resource schemas.
//!
//! Generated by firestone. Do not edit: change `methods` or `security` in the
//! resource files and regenerate.
//!
//! Adding your own middleware is a `.layer(...)` here, or a `.route_layer(...)` on
//! a single group if it should only cover some of the routes, the way the bearer
//! check below only covers the operations the schemas marked as secured.

use std::time::Duration;

use axum::http::StatusCode;
use axum::middleware;
{% for verb in verbs %}use axum::routing::{{ verb }};
{% endfor %}use axum::Router;
use tower_http::limit::RequestBodyLimitLayer;
use tower_http::timeout::TimeoutLayer;
use tower_http::trace::TraceLayer;

use crate::handlers;
use crate::AppState;

/// The largest request body this API will read, in bytes.
const MAX_BODY: usize = 1024 * 1024;

/// The longest a handler may take before the caller is given up on.
const TIMEOUT: Duration = Duration::from_secs(30);

/// Build the router for every resource firestone generated.
pub fn router(state: AppState) -> Router {
    let open = Router::new()
{%- for rsrc in resources %}
{%- set open_resource = rsrc.resource_methods | reject("in", rsrc.secured_resource) | list %}
{%- if open_resource %}
        // {{ rsrc.kind }}
        .route(
            "/{{ rsrc.path }}",
            {% for method in open_resource %}{{ method }}(handlers::{{ rsrc.module }}::{{ method }}_collection){% if not loop.last %}
                .{% endif %}{% endfor %},
        )
{%- endif %}
{%- set open_instance = rsrc.instance_methods | reject("in", rsrc.secured_instance) | list %}
{%- if open_instance %}
        .route(
            "/{{ rsrc.path }}/{% raw %}{{% endraw %}{{ rsrc.key }}{% raw %}}{% endraw %}",
            {% for method in open_instance %}{{ method }}(handlers::{{ rsrc.module }}::{{ method }}_instance){% if not loop.last %}
                .{% endif %}{% endfor %},
        )
{%- endif %}
{%- set open_attrs = rsrc.attr_methods | reject("in", rsrc.secured_attrs) | list %}
{%- if open_attrs %}
        .route(
            "/{{ rsrc.path }}/{% raw %}{{% endraw %}{{ rsrc.key }}{% raw %}}{% endraw %}/{% raw %}{attr}{% endraw %}",
            {% for method in open_attrs %}{{ method }}(handlers::{{ rsrc.module }}::{{ method }}_attr){% if not loop.last %}
                .{% endif %}{% endfor %},
        )
{%- endif %}
{%- endfor %}
        ;

{% if secured %}    // Only the operations the resource files marked as secured.
    let secured = Router::new()
{%- for rsrc in resources %}
{%- set secured_resource = rsrc.resource_methods | select("in", rsrc.secured_resource) | list %}
{%- if secured_resource %}
        .route(
            "/{{ rsrc.path }}",
            {% for method in secured_resource %}{{ method }}(handlers::{{ rsrc.module }}::{{ method }}_collection){% if not loop.last %}
                .{% endif %}{% endfor %},
        )
{%- endif %}
{%- set secured_instance = rsrc.instance_methods | select("in", rsrc.secured_instance) | list %}
{%- if secured_instance %}
        .route(
            "/{{ rsrc.path }}/{% raw %}{{% endraw %}{{ rsrc.key }}{% raw %}}{% endraw %}",
            {% for method in secured_instance %}{{ method }}(handlers::{{ rsrc.module }}::{{ method }}_instance){% if not loop.last %}
                .{% endif %}{% endfor %},
        )
{%- endif %}
{%- set secured_attrs = rsrc.attr_methods | select("in", rsrc.secured_attrs) | list %}
{%- if secured_attrs %}
        .route(
            "/{{ rsrc.path }}/{% raw %}{{% endraw %}{{ rsrc.key }}{% raw %}}{% endraw %}/{% raw %}{attr}{% endraw %}",
            {% for method in secured_attrs %}{{ method }}(handlers::{{ rsrc.module }}::{{ method }}_attr){% if not loop.last %}
                .{% endif %}{% endfor %},
        )
{%- endif %}
{%- endfor %}
        .route_layer(middleware::from_fn_with_state(
            state.clone(),
            crate::middleware::require_bearer,
        ));

    let routes = open.merge(secured);
{% else %}    let routes = open;
{% endif %}
    routes
        // Applied to everything, so a caller cannot avoid the limiter by picking an
        // unauthenticated route.
        .route_layer(middleware::from_fn_with_state(
            state.clone(),
            crate::middleware::rate_limit,
        ))
        .layer(TraceLayer::new_for_http())
        .layer(TimeoutLayer::with_status_code(
            StatusCode::GATEWAY_TIMEOUT,
            TIMEOUT,
        ))
        .layer(RequestBodyLimitLayer::new(MAX_BODY))
        .with_state(state)
}
