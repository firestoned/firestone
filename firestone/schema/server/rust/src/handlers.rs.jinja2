//! The implementation of every trait the generated server declares.
//!
//! Generated by firestone from the same OpenAPI document as the server, so the two
//! cannot disagree about an operation id, a model name or a response variant.
//! Do not edit: change the resource files and regenerate.
//!
//! Each handler does the same three things - pull the request apart, enforce the
//! rules the schema declares, then hand off to the [`Backend`](crate::backend::Backend).
//! Only the last of those is yours to write.

use async_trait::async_trait;
use axum_extra::extract::CookieJar;
use axum_extra::extract::Host;
use http::Method;
{%- if needs_value %}
use serde_json::Value;
{%- endif %}

use {{ api_pkg }}::apis;
{%- if needs_models %}
use {{ api_pkg }}::models;
{%- endif %}

{% if needs_from_json %}use crate::error::from_json;
{% endif %}{% if needs_to_json %}use crate::error::to_json;
{% endif %}use crate::error::Error;
use crate::Api;
{%- if validations %}
use crate::resolver::validate_request;
use crate::resolver::validate_subject;
{%- endif %}
{% for tag, info in traits.items() %}
#[async_trait]
impl apis::{{ info.module }}::{{ info.trait }}<Error> for Api {
{%- if info.claims %}
    type Claims = crate::auth::Claims;
{%- endif %}
{% for op in info.operations %}
    /// {{ op.method|upper }} {{ op.path }}
    async fn {{ op.name }}(
        &self,
        _method: &Method,
        _host: &Host,
        _cookies: &CookieJar,
{%- if op.claims %}
        _claims: &Self::Claims,
{%- endif %}
{%- if op.path_params %}
        {% if op.uses_key %}path_params{% else %}_path_params{% endif %}: &models::{{ op.name|pascal }}PathParams,
{%- endif %}
{%- if op.query_params %}
        _query_params: &models::{{ op.name|pascal }}QueryParams,
{%- endif %}
{%- if op.body %}
        {% if op.uses_body %}body{% else %}_body{% endif %}: &{{ op.body }},
{%- endif %}
    ) -> Result<apis::{{ info.module }}::{{ op.response }}, Error> {
{%- if op.implemented %}
        use apis::{{ info.module }}::{{ op.response }} as Response;
{%- endif %}
{%- if not op.action %}

        // Firestone does not generate a body for this operation: the document
        // declares no request body or no success response, or the method means
        // something a replace would get wrong. Implement it by hand if you need it.
        Err(Error::NotImplemented(
            "{{ op.method|upper }} {{ op.path }} is not generated; implement it by hand".into(),
        ))
{%- elif op.action == "head" %}

        Ok(Response::{{ op.success.variant }})
{%- elif op.action == "list" %}

        let items = self.backend.list("{{ op.resource }}").await?;

        Ok(Response::{{ op.success.variant }}(from_json(Value::Array(items))?))
{%- elif op.action == "create" %}

        let body = to_json(body)?;
{%- if op.rules %}
        validate_request(self, "post", "{{ op.resource }}", Some(&body), None).await?;
{%- endif %}
        let (key, {% if info.key_field %}mut {% endif %}created) = self.backend.create("{{ op.resource }}", body).await?;
        tracing::info!(resource = "{{ op.resource }}", key, "created");
{%- if info.key_field %}

        // The backend mints the key, so the caller is told what it was: without it
        // there is no way to GET, PUT or DELETE what was just created.
        if let Some(object) = created.as_object_mut() {
            object.insert("{{ info.key_field }}".to_string(), Value::String(key));
        }
{%- endif %}

        Ok(Response::{{ op.success.variant }}(from_json(created)?))
{%- elif op.action == "fetch" %}

        let key = &path_params.{{ op.key }};
        let found = self.backend.get("{{ op.resource }}", key).await?;

        Ok(Response::{{ op.success.variant }}(from_json(
            found.ok_or_else(|| Error::not_found("{{ op.resource }}", key))?,
        )?))
{%- elif op.action == "update" %}

        let key = &path_params.{{ op.key }};
        let body = to_json(body)?;
{%- if op.rules %}
        // Rules comparing against the current state need it, whether or not the
        // backend would have.
        let current = self.backend.get("{{ op.resource }}", key).await?;
        validate_request(self, "{{ op.method }}", "{{ op.resource }}", Some(&body), current.as_ref()).await?;
{%- endif %}
        let stored = self.backend.{% if op.method == "put" %}replace{% else %}patch{% endif %}("{{ op.resource }}", key, body).await?;

        Ok(Response::{{ op.success.variant }}(from_json(stored)?))
{%- elif op.action == "remove" %}

        let key = &path_params.{{ op.key }};
        let current = self
            .backend
            .get("{{ op.resource }}", key)
            .await?
            .ok_or_else(|| Error::not_found("{{ op.resource }}", key))?;
{%- if op.rules %}
        // A delete has no body, so the rules see the resource that is about to go.
        validate_request(self, "delete", "{{ op.resource }}", None, Some(&current)).await?;
{%- endif %}
        self.backend.delete("{{ op.resource }}", key).await?;
        tracing::info!(resource = "{{ op.resource }}", key, "deleted");

        Ok(Response::{{ op.success.variant }}({% if op.success.payload %}from_json(current)?{% endif %}))
{%- elif op.action == "attr_get" %}

        let key = &path_params.{{ op.key }};
        let found = self
            .backend
            .get("{{ op.resource }}", key)
            .await?
            .ok_or_else(|| Error::not_found("{{ op.resource }}", key))?;
        let value = found
            .get("{{ op.attr }}")
            .cloned()
            .ok_or_else(|| Error::not_found("{{ op.resource }} {{ op.attr }}", key))?;

        Ok(Response::{{ op.success.variant }}(from_json(value)?))
{%- elif op.action == "attr_set" %}

        let key = &path_params.{{ op.key }};
        let current = self
            .backend
            .get("{{ op.resource }}", key)
            .await?
            .ok_or_else(|| Error::not_found("{{ op.resource }}", key))?;
        let value = to_json(body)?;

        let mut updated = current.clone();
        updated
            .as_object_mut()
            .ok_or_else(|| Error::Internal("the stored resource is not an object".into()))?
            .insert("{{ op.attr }}".to_string(), value.clone());
{%- if op.rules %}
        // The rules are written against the whole resource, so they are given the
        // resource as it will be rather than the attribute on its own.
        validate_subject(self, "{{ op.method }}", "{{ op.resource }}", &updated, Some(&current)).await?;
{%- endif %}
        self.backend.replace("{{ op.resource }}", key, updated).await?;

        Ok(Response::{{ op.success.variant }}({% if op.success.payload %}from_json(value)?{% endif %}))
{%- elif op.action == "attr_remove" %}

        let key = &path_params.{{ op.key }};
        let current = self
            .backend
            .get("{{ op.resource }}", key)
            .await?
            .ok_or_else(|| Error::not_found("{{ op.resource }}", key))?;
        let removed = current
            .get("{{ op.attr }}")
            .cloned()
            .ok_or_else(|| Error::not_found("{{ op.resource }} {{ op.attr }}", key))?;

        let mut updated = current.clone();
        updated
            .as_object_mut()
            .ok_or_else(|| Error::Internal("the stored resource is not an object".into()))?
            .remove("{{ op.attr }}");
{%- if op.rules %}
        validate_subject(self, "{{ op.method }}", "{{ op.resource }}", &updated, Some(&current)).await?;
{%- endif %}
        self.backend.replace("{{ op.resource }}", key, updated).await?;

        Ok(Response::{{ op.success.variant }}({% if op.success.payload %}from_json(removed)?{% endif %}))
{%- endif %}
    }
{% endfor -%}
}
{% endfor %}
